# ── Vastu Arya Backend — env template (Phase E) ─────────────────────
# Copy to .env and fill in real values. Any value can be overridden at
# deploy-time by the host's env-var settings (Render, etc).

# ── Core ────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/vastuarya
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://vastuarya.com

# ── Razorpay ────────────────────────────────────────────────────────
# Test keys are fine for staging; production must use live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret from Dashboard → Settings → Webhooks. Required
# for /api/payment/webhook to accept anything at all.
RAZORPAY_WEBHOOK_SECRET=

# ── AI providers (any ONE is enough) ────────────────────────────────
# Preferred: Emergent Universal Key (single key across GPT/Claude/Gemini
# via the emergentintegrations proxy). Enables text AND image analysis.
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional direct keys — used as fallback if EMERGENT_LLM_KEY is unset.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=app-specific-password
ADMIN_NOTIFICATION_EMAIL=admin@vastuarya.com
WHATSAPP_NUMBER=+91-7000343804

# ── Cloudinary (UPI screenshots + product images) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional feature flags ──────────────────────────────────────────
# When set to 1, /api/payment/webhook will log every event to stdout.
WEBHOOK_DEBUG=0
